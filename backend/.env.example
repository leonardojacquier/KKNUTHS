# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (Claude)
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-4-8
CHEAP_MODEL=claude-haiku-4-5-20251001

# Embeddings (Anthropic não tem; use Voyage OU OpenAI). Dim deve casar com schema (1536).
# Com OpenAI: EMBEDDING_MODEL=text-embedding-3-small | Com Voyage: voyage-large-2
VOYAGE_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Supabase / Postgres
# Projeto: kknuths-poker (ref htvjviovcfvtpgeloekn, região sa-east-1)
SUPABASE_URL=https://htvjviovcfvtpgeloekn.supabase.co
# service_role key: copie de Supabase Dashboard > Project Settings > API (NÃO commitar)
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Redis (fila de jobs)
REDIS_URL=redis://localhost:6379/0

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# App
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_LANG=pt
# Portal de gestão (/admin?key=...) — gere um token longo aleatório
ADMIN_TOKEN=

# Cota do beta gratuito (protege o custo de LLM sem billing)
FREE_MONTHLY_ANALYSES=100
MAX_UPLOAD_MB=2
MAX_COACHED_HANDS=5
